# ── 必需 ──
MEDIA_API_KEY=           # 118api.cn API Key（Gemini 多模态调用）

# ── 可选：LLM 重写 ──
OPENAI_API_KEY=           # LLM API Key（不设置则使用 MEDIA_API_KEY）
OPENAI_BASE_URL=          # 默认 https://118api.cn/v1
OPENAI_MODEL=             # 默认 gemini-3-flash-preview
OPENAI_TIMEOUT=45
OPENAI_MAX_INPUT_CHARS=12000

# ── 可选：视频处理 ──
DEEPGRAM_API_KEY=         # Deepgram API Key（音频转写）
WEB_FETCH_VIDEO_VLM_API_KEY=    # 视频视觉分析 API Key（默认使用 MEDIA_API_KEY）
WEB_FETCH_VIDEO_VLM_BASE_URL=   # 默认 https://118api.cn/v1
WEB_FETCH_VIDEO_VLM_MODEL=      # 默认 gemini-3-flash-preview

# ── 可选：抖音专用 ──
DOUYIN_COOKIE_FILE=       # 抖音 cookies 文件（Netscape 格式，默认 ~/.config/axia-multimedia-to-note/cookies/douyin.txt）
DOUYIN_PAGE_TIMEOUT=30    # 页面加载超时（秒）
DOUYIN_CDN_TIMEOUT=120    # CDN 下载超时（秒）

# ── 可选：润色 ──
WEB_FETCH_POLISH_AGENT=kimi     # kimi | claude | custom | none
WEB_FETCH_DISABLE_POLISH=false  # true 禁用润色
KIMI_CLI_PATH=kimi
CLAUDE_CLI_PATH=claude

# ── 可选：输出 ──
WEB_FETCH_OUTPUT_DIR=    # 笔记输出目录（默认 ~/Documents/AIC-000/Web Clippings）
WEB_FETCH_VAULT_ROOT=    # Obsidian vault 根目录

# ── 可选：GitHub ──
GITHUB_TOKEN=            # GitHub API Token（提高速率限制）
