# axia-multimedia-to-note 环境变量配置
# 复制为 .env 并按需填写: cp .env.example .env

# ============================================================================
# 必需
# ============================================================================

# API Key — 用于 Gemini 多模态调用（视觉分析、LLM 重写）
# 不设置则视频分析和 LLM 重写均不可用，仅文章抓取可用
MEDIA_API_KEY=

# ============================================================================
# 视频（可选）
# ============================================================================

# Deepgram API Key — 开启音频转写
# 不设置则跳过音频转写，仅视觉分析
# DEEPGRAM_API_KEY=

# 视频网络模式: direct（直连）| system（使用系统代理）| auto（YouTube 自动切代理）
# VIDEO_NETWORK_MODE=direct

# 长视频截取前 N 秒（避免文件过大超出 API 限制）
# VIDEO_MAX_DURATION=120

# 视频文件大小上限 (MB)，0 = 不限制
# VIDEO_MAX_SIZE_MB=100

# Gemini 视觉分析超时 (秒)
# VIDEO_VLM_TIMEOUT=300

# 临时文件目录
# VIDEO_TEMP_ROOT=/tmp

# yt-dlp 可执行文件路径（默认 PATH 中的 yt-dlp）
# WEB_FETCH_YT_DLP=yt-dlp

# ============================================================================
# 抖音专用（可选）
# ============================================================================

# 抖音 cookies 文件 (Netscape 格式)
# 使用浏览器插件导出，如 EditThisCookie、Get cookies.txt LOCALLY
# 默认位置: ~/.config/axia-multimedia-to-note/cookies/douyin.txt
# DOUYIN_COOKIE_FILE=

# Playwright 页面加载超时 (秒)
# DOUYIN_PAGE_TIMEOUT=30

# CDN 视频下载超时 (秒)
# DOUYIN_CDN_TIMEOUT=120

# ============================================================================
# LLM 重写（可选）
# ============================================================================

# LLM API Key — 不设置则使用 MEDIA_API_KEY
# OPENAI_API_KEY=

# LLM API Base URL
# OPENAI_BASE_URL=https://118api.cn/v1

# LLM 模型
# OPENAI_MODEL=gemini-3-flash-preview

# OPENAI_TIMEOUT=45
# OPENAI_MAX_INPUT_CHARS=12000

# ============================================================================
# 润色（可选）
# ============================================================================

# 润色 agent: kimi | claude | custom | none
# WEB_FETCH_POLISH_AGENT=kimi

# 禁用润色
# WEB_FETCH_DISABLE_POLISH=false

# 自定义 CLI 路径
# KIMI_CLI_PATH=kimi
# CLAUDE_CLI_PATH=claude

# ============================================================================
# 输出（可选）
# ============================================================================

# 笔记输出目录
# WEB_FETCH_OUTPUT_DIR=~/Documents/AIC-000/Web Clippings

# Obsidian vault 根目录
# WEB_FETCH_VAULT_ROOT=~/Documents/AIC-000

# ============================================================================
# GitHub（可选）
# ============================================================================

# GitHub API Token — 提高速率限制
# GITHUB_TOKEN=
